[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[packages]
# The blog and privacy plugins that used to require Mkdocs Material Insiders
# are part of the free community edition since 9.5, so the previously used
# private Insiders fork is no longer needed.
mkdocs-material = ">=9.5"

[dev-packages]
invoke = "*"

[requires]
python_version = "3.12"

[pipenv]
allow_prereleases = true
